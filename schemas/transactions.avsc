{
  "type": "record",
  "name": "PaymentTransaction",
  "namespace": "com.bootcamp.payments",
  "fields": [
    {"name": "transaction_id", "type": "long"},
    {"name": "account_id", "type": "int"},
    {"name": "card_id", "type": "int"},
    {"name": "merchant_id", "type": "int"},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 15, "scale": 2}},
    {"name": "currency", "type": "string", "default": "BRL"},
    {"name": "transaction_status", "type": "string", "default": "APPROVED"},
    {"name": "transaction_time", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
